# =============================================================================
# Airflow Docker Image — Healthcare Data Lakehouse
# =============================================================================
# Extends the official Airflow 2.8 image with project-specific dependencies:
#   - PySpark + Delta Lake for medallion pipeline
#   - dbt-duckdb for warehouse transformations
#   - DuckDB for lightweight analytics
#   - Great Expectations patterns for data quality
#
# Build context should be the project root (../../ from this file).
# =============================================================================

FROM apache/airflow:2.8.1-python3.10

USER root

# Install Java 17 (required for PySpark/Delta)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openjdk-17-jre-headless \
        curl \
        git && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

USER airflow

# Install Python dependencies
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && \
    pip install --no-cache-dir \
        apache-airflow-providers-common-sql==1.11.1 \
        dbt-duckdb>=1.7.0

# Set working directory
WORKDIR /opt/airflow
